<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RouteSMS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_high</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorAccent">@color/accent_primary_light</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/graphite</item>
        <item name="android:statusBarColor">@color/graphite</item>
        <item name="android:navigationBarColor">@color/graphite</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.RouteSMS.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/accent_primary</item>
    </style>

    <style name="Widget.RouteSMS.IconButton" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/surface_high</item>
    </style>
</resources>
